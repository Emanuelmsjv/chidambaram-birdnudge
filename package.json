{
  "name": "chidambaram-birdnudge",
  "version": "0.1.0",
  "private": true,
  "description": "Offline open-weight bird ID that turns a local species pack into a reason to go outside. Chidambaram, Tamil Nadu.",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "setup": "node scripts/download-model.mjs && npm run pack",
    "model": "node scripts/download-model.mjs",
    "pack": "node scripts/fetch-pack.mjs",
    "convert": "node scripts/convert.mjs",
    "analyze": "node scripts/analyze.mjs",
    "summarize": "node scripts/summarize.mjs",
    "case": "node scripts/case.mjs",
    "summarize:samples": "node scripts/summarize.mjs --dir data/samples",
    "nudge": "node scripts/nudge.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "^1.26.0"
  },
  "engines": {
    "node": ">=18"
  }
}
